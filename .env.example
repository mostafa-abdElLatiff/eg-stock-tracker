# Copy this to .env for local dev. In Vercel, set these as Project
# Environment Variables instead (Settings -> Environment Variables).
#
# The anon key is SAFE to expose in client code by design - Supabase's
# security model relies on Row Level Security (RLS), not on hiding this key.
# Never put the service_role key here or in any client-facing file - it
# bypasses RLS entirely and belongs only in the GitHub Action secret.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
